# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Public origin used to build auth redirect links.
# Leave as-is for local development; set to the deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP, for invite and settlement emails. Server-side only — never expose these
# to the browser. Without them the app still works: it reports that an email was
# not sent rather than pretending it was.
#
# Any provider will do; they all speak SMTP. For Gmail, turn on 2-Step
# Verification and create an App Password — the account password will not work,
# and Gmail rewrites From to the authenticated account, so EMAIL_FROM must use
# the same address as SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM="Gas Split <you@gmail.com>"
