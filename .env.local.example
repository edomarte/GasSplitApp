# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Public origin used to build auth redirect links.
# Leave as-is for local development; set to the deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend, for invite and settlement emails. Server-side only — never expose
# these to the browser. Without them the app still works: it reports that an
# email was not sent rather than pretending it was.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM="Gas Split <invites@your-verified-domain.com>"
